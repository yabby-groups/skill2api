# Required: Periodic endpoint and the absolute directory for job output.
export PERIODIC_PORT="tcp://127.0.0.1:5000"
export SKILL2API_OUTPUT_ROOT="/absolute/path/to/skill2api/output"

# Optional: defaults to skills and codex.
export SKILL2API_SKILLS_DIR="skills"
export SKILL2API_CODEX_BIN="codex"
export TASK_PREFIX=""

# Local development uses Periodic plain mode. For RSA mode, set a nonzero mode
# and provide both key paths below.
export PERIODIC_RSA_MODE="0"
export PERIODIC_RSA_PRIVATE_KEY_PATH=""
export PERIODIC_RSA_PUBLIC_KEY_PATH=""

# Execution limits. Timeout defaults to 21600 seconds (6 hours).
export SKILL2API_CODEX_TIMEOUT_SECONDS="21600"
export SKILL2API_MAX_OUTPUT_BYTES="65536"
export SKILL2API_MAX_FILE_BYTES="67108864"

# Native Codex execution. Set these to true only when the skill requires it.
export SKILL2API_CODEX_NO_PROXY="false"

# Docker Codex runner. Leave disabled for native execution.
export SKILL2API_CODEX_DOCKER="false"
export SKILL2API_CODEX_DOCKER_BIN="docker"
export SKILL2API_CODEX_DOCKER_IMAGE="lupino/sandbox-runner:latest"
# Must be an existing host directory when Docker mode is enabled; otherwise empty.
export SKILL2API_CODEX_DOCKER_OPT_DIR=""

# Optional deployment-level provider credential fallback. Prefer passing this
# per request through the generate/resume environment object. Never commit a value.
export OPENAI_API_KEY=""
export OPENAI_BASE_URL="https://huabot.com/v1"
